# Greift nur, wenn der Webserver auf den Projektordner statt auf public/ zeigt
# (z. B. Shared Hosting mit Aufruf über …/elterninfoboard/public/).
# Empfohlen bleibt: DocumentRoot direkt auf public/ setzen.
#
# Öffentlich ist nur public/. Alles andere (.env, storage/, vendor/, config/ …)
# wird gesperrt; der Aufruf des Projektordners selbst leitet nach public/ weiter.

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    RewriteRule ^public(/.*)?$ - [L]
    RewriteRule ^$ %{REQUEST_URI}public/ [R=302,L]
    RewriteRule ^ - [F]
</IfModule>

# Ohne mod_rewrite: nichts aus dem Projektordner ausliefern
<IfModule !mod_rewrite.c>
    Require all denied
</IfModule>
